# ==============================================================================
# ActionRunner Distributed Execution Worker Environment Configuration
# Path: /etc/action-runner/worker.env (Permissions: 0600 action-runner:action-runner)
# ==============================================================================

# Unique identifier for this worker node (e.g. entrance, rubicon, pey-wail-deu)
ACTION_RUNNER_NODE_ID=worker-node

# WebSocket URL to Controller cluster tunnel
# Local controller: ws://127.0.0.1:8000/api/cluster/tunnel
# Remote controller: ws://192.168.1.117:8000/api/cluster/tunnel
# Over WAN: wss://hook.lma1980.duckdns.org/api/cluster/tunnel
ACTION_RUNNER_CONTROLLER_URL=ws://192.168.1.117:8000/api/cluster/tunnel

# Path to shared authentication token file (or literal token)
ACTION_RUNNER_CLUSTER_TOKEN=/etc/action-runner/cluster_token

# Concurrency execution slots on this worker node
# E.g. 2 for Intel N100, 4 for Xeon E3-1245, 6 for SpacemiT K3 (16 cores)
ACTION_RUNNER_SLOTS=6

# Optional compiler/worker build thread override for cargo tasks
CARGO_BUILD_JOBS=6

# Comma-separated capability tags advertised to the DAG stage scheduler
# Intel N100:     x86_64,linux,n100,fmt,audit,docs
# Xeon E3-1245:   x86_64,linux,xeon,clippy,cross-compile,riscv64,build,test
# SpacemiT K3:    riscv64,spacemit,k3,x100,a100,native,ground-truth,bench,verification
ACTION_RUNNER_TAGS=x86_64,linux,worker

# Base workspace directory for git caches and stage builds
ACTION_RUNNER_WORKSPACE=/var/lib/action-runner/workspace

# Enable Btrfs subvolume snapshot isolation (true if workspace is on a Btrfs filesystem)
ACTION_RUNNER_USE_BTRFS=true

# Optional Toolchain Roots (for cross-compiler or native edge compiler discovery)
# LLVM_TOOLCHAIN_ROOT=/opt/cross-llvm-24
# GCC_TOOLCHAIN_ROOT=/opt/cross-gcc-17

# Logging level
RUST_LOG=info,action_runner=debug
