# Node rubicon (HP Z230 Xeon E3-1245 v3 4C/8T @ 3.8GHz, 32GB DDR3, Btrfs RAID1)
# Roles: Heavy Linter (clippy), Cross-Compiler (llvm-24, gcc-17), Heavy Builds

ACTION_RUNNER_NODE_ID=rubicon
ACTION_RUNNER_ARCH=x86_64
ACTION_RUNNER_TAGS=x86_64,clippy,build,cross,heavy,llvm-24,gcc-17
ACTION_RUNNER_MAX_SLOTS=4
ACTION_RUNNER_USE_BTRFS=true
ACTION_RUNNER_ISOLATION_MODE=none
ACTION_RUNNER_TOOLCHAINS=system,llvm-24,gcc-17
ACTION_RUNNER_WORKSPACE=/var/lib/action-runner/workspace
