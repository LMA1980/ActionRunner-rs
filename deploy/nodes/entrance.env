# Node entrance (Intel N100 4C/4T @ 3.4GHz, 32GB DDR5, NVMe Btrfs)
# Roles: Fast Linter (fmt, mdformat), Dependency Audits (audit), Lightweight Verification

ACTION_RUNNER_NODE_ID=entrance
ACTION_RUNNER_ARCH=x86_64
ACTION_RUNNER_TAGS=x86_64,n100,fmt,audit,light
ACTION_RUNNER_MAX_SLOTS=2
ACTION_RUNNER_USE_BTRFS=true
ACTION_RUNNER_ISOLATION_MODE=none
ACTION_RUNNER_TOOLCHAINS=system
ACTION_RUNNER_WORKSPACE=/var/lib/action-runner/workspace
